<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <AssemblyName>SourceCodeEditor</AssemblyName>
    <Version>0.5.1</Version>
    <RootNamespace>SourceCodeEditor</RootNamespace>
    <ApplicationIcon>SourceCodeEditor.ico</ApplicationIcon>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="MainForm.cs" />
    <Compile Include="MainForm.FontSizing.cs" />
    <Compile Include="MainForm.Editing.cs" />
    <Compile Include="MainForm.Explorer.cs" />
    <Compile Include="MainForm.Shell.cs" />
    <Compile Include="EmbeddedShellControl.cs" />
    <Compile Include="WindowsPseudoConsole.cs" />
    <Compile Include="ConPtySelfTest.cs" />
    <Compile Include="TerminalScreen.cs" />
    <Compile Include="TextSourceFileFilter.cs" />
    <Compile Include="MainForm.Session.cs" />
    <Compile Include="LineNumberedRichTextBox.cs" />
    <Compile Include="DocumentModel.cs" />
    <Compile Include="SearchDialog.cs" />
    <Compile Include="FindInFilesDialog.cs" />
  </ItemGroup>
</Project>
